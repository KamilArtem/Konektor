# Build-time / local dev variables for Astro. Copy to .env (never commit .env).
# Same values must be set as Build variables in Cloudflare (Workers Builds) / GitHub Actions.
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production
SANITY_API_VERSION=2025-11-01
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
