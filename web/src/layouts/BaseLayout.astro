---
import '@/styles/global.css'
import Navbar from '@/components/Navbar.astro'
import {sanityFetch} from '@/sanity/client'
import {SETTINGS_QUERY, NAVIGATION_QUERY} from '@/sanity/queries'
import {urlFor} from '@/sanity/image'

interface Seo {
  title?: string
  description?: string
  ogImage?: any
  noIndex?: boolean
}

interface Props {
  title?: string
  seo?: Seo | null
  hideGlobalNav?: boolean
}

const {title, seo, hideGlobalNav = false} = Astro.props

const [settings, nav] = await Promise.all([
  sanityFetch<any>(SETTINGS_QUERY, {}, null),
  sanityFetch<{services: {title: string; shortTitle?: string; slug: string}[]}>(NAVIGATION_QUERY, {}, {services: []}),
])

const siteName = settings?.companyName ?? 'Konektor'
const metaTitle = seo?.title || (title ? `${title} | ${siteName}` : settings?.seo?.title || siteName)
const metaDescription = seo?.description || settings?.seo?.description || ''
const ogSource = seo?.ogImage ?? settings?.seo?.ogImage
const ogImage = ogSource?.asset ? urlFor(ogSource).width(1200).height(630).fit('crop').url() : undefined
const canonical = new URL(Astro.url.pathname, Astro.site)
const phone = settings?.phone ?? '+48 781 262 626'
const email = settings?.email ?? 'bok@konektor.com.pl'
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metaTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    <link rel="canonical" href={canonical} />
    {seo?.noIndex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={metaTitle} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    
    <!-- Google Fonts: Urbanist (weights 400, 500, 600) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Urbanist:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
  </head>
  <body>
    {!hideGlobalNav && <Navbar siteName={siteName} services={nav.services} />}

    <main>
      <slot />
    </main>

    <!-- UI: footer to be designed -->
    <footer class="border-t border-slate-200 bg-white text-slate-600 py-12 padding-global">
      <div class="w-full flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-sm">
        <div>
          {settings?.footerTagline && <p class="text-slate-900 font-medium mb-1">{settings.footerTagline}</p>}
          <p><a href={`tel:${phone.replace(/\s/g, '')}`} class="hover:text-slate-900">{phone}</a> · <a href={`mailto:${email}`} class="hover:text-slate-900">{email}</a></p>
          {
            settings?.address && (
              <address class="not-italic text-slate-500 mt-1">
                {settings.address.street}, {settings.address.postalCode} {settings.address.city}
              </address>
            )
          }
        </div>
        <p class="text-slate-400">© {new Date().getFullYear()} {settings?.legalName ?? siteName}</p>
      </div>
    </footer>
  </body>
</html>
