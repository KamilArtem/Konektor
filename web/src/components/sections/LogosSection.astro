---
import { urlFor } from "@/sanity/image";

interface ClientLogo {
  _id: string;
  name: string;
  logo?: any;
  url?: string;
}

interface Props {
  eyebrow?: string;
  text?: string;
  heading?: string;
  logos?: ClientLogo[];
}

const {
  eyebrow = "Doświadczenie i precyzja",
  text = "Od ponad 20 lat wspieramy firmy i instytucje w budowaniu bezpiecznej infrastruktury technicznej. Od analizy potrzeb, przez projekt i certyfikowaną instalację, aż po stały serwis – dostarczamy rozwiązania gwarantujące pełną ochronę i zgodność z normami.",
  heading = "Zaufali nam",
  logos = [],
} = Astro.props;

const fallbackLogos: Record<string, string> = {
  Multikino:
    "https://cdn.prod.website-files.com/67fcf552aabd7781de663999/67fd0452b0f316f974e8722c_multikino%20logo%20(1).png",
  Iveco:
    "https://cdn.prod.website-files.com/67fcf552aabd7781de663999/67fd0be78441980ea6cba3d2_IvecoTNC%20logo%20(1).webp",
};
---

<section
  data-section="logosSection"
  class="bg-white text-slate-900 py-24 sm:py-32 padding-global"
>
  <div class="w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <!-- Left Column: Editorial Tagline -->
      <div class="lg:col-span-5 pt-1">
        <p class="inline-flex items-center gap-3 text-base font-medium tracking-[-0.01em] text-slate-500">
          <span aria-hidden="true" class="w-4 h-px bg-slate-300"></span>
          <span>{eyebrow}</span>
        </p>
      </div>

      <!-- Right Column: Editorial Statement + Partner Logos -->
      <div class="lg:col-span-7">
        <p class="text-2xl sm:text-3xl lg:text-[2rem] leading-[1.25] tracking-[-0.02em] text-slate-900 font-normal">
          {text}
        </p>

        {logos.length > 0 && (
          <div class="mt-14 sm:mt-16">
            <p class="text-base font-medium tracking-[-0.01em] text-slate-500 mb-7">
              {heading}
            </p>

            <ul class="flex flex-wrap items-center gap-x-10 sm:gap-x-14 gap-y-6">
              {logos.map((l) => {
                const src = l.logo?.asset
                  ? urlFor(l.logo).height(80).auto("format").url()
                  : fallbackLogos[l.name];

                const content = src ? (
                  <img
                    src={src}
                    alt={l.name}
                    loading="lazy"
                    class="h-10 sm:h-12 w-auto object-contain grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300 ease-spring"
                  />
                ) : (
                  <span class="text-xl sm:text-2xl font-medium tracking-tight text-slate-400 hover:text-slate-700 transition-colors">
                    {l.name}
                  </span>
                );

                return (
                  <li>
                    {l.url ? (
                      <a
                        href={l.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={l.name}
                      >
                        {content}
                      </a>
                    ) : (
                      content
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        )}
      </div>
    </div>
  </div>
</section>
