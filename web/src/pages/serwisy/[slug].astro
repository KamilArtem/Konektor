---
import type {GetStaticPaths} from 'astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import SectionRenderer from '@/components/SectionRenderer.astro'
import {sanityFetch} from '@/sanity/client'
import {SERVICE_QUERY, SERVICE_SLUGS_QUERY} from '@/sanity/queries'
import {urlFor} from '@/sanity/image'

export const getStaticPaths = (async () => {
  const slugs = await sanityFetch<string[]>(SERVICE_SLUGS_QUERY, {}, [])
  return slugs.map((slug) => ({params: {slug}}))
}) satisfies GetStaticPaths

const {slug} = Astro.params
const service = await sanityFetch<any>(SERVICE_QUERY, {slug}, null)
if (!service) return Astro.redirect('/404')
---

<BaseLayout title={service.title} seo={service.seo}>
  <!-- UI: service hero -->
  <section data-section="serviceHero">
    <h1>
      {service.hero?.heading ?? service.title}
      {service.hero?.highlight && <span>{service.hero.highlight}</span>}
    </h1>
    {service.hero?.intro && <p>{service.hero.intro}</p>}
    <a href="/kontakt">Zapytaj o ofertę</a>
    {service.hero?.image?.asset && <img src={urlFor(service.hero.image).width(1600).auto('format').url()} alt="" />}
  </section>

  {
    service.benefits?.length > 0 && (
      <section data-section="serviceBenefits">
        <ul>
          {service.benefits.map((b: any) => (
            <li>
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <SectionRenderer sections={service.sections} />
</BaseLayout>
