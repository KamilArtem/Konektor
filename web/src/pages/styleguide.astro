---
import BaseLayout from '@/layouts/BaseLayout.astro'
import {
  Flame,
  Volume2,
  Lock,
  Camera,
  ShieldCheck,
  Building2,
  ArrowUpRight,
  PhoneCall,
  Mail,
  CheckCircle2,
  AlertCircle,
  ExternalLink,
  ChevronDown,
  Sparkles
} from 'lucide-astro'
---

<BaseLayout title="Styleguide & Interactive Component Lab | Konektor" seo={{title: "Styleguide & Component Lab | Konektor", noIndex: true}}>
  <!-- Sticky Sub-Nav -->
  <header class="border-b border-slate-200/80 bg-white/80 backdrop-blur-md sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-red-600 flex items-center justify-center text-white font-bold text-sm">
            K
          </div>
          <span class="font-bold tracking-tight text-slate-900 text-lg">KONEKTOR</span>
        </a>
        <div class="h-4 w-px bg-slate-200 mx-2"></div>
        <span class="text-xs font-semibold uppercase tracking-[0.2em] px-2.5 py-1 rounded-full bg-red-50 text-red-700 border border-red-200/60">
          Component Lab
        </span>
      </div>

      <div class="flex items-center gap-4 text-sm font-medium">
        <a href="/design-guidelines" class="text-slate-600 hover:text-slate-900 transition-colors">
          ← Wróć do Guidelines
        </a>
      </div>
    </div>
  </header>

  <main class="min-h-screen bg-[#F8F9FA] text-slate-900 pb-36 px-6 max-w-7xl mx-auto">
    <!-- Intro -->
    <div class="pt-16 pb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 border border-slate-200 text-slate-600 text-xs font-semibold uppercase tracking-[0.2em] mb-4">
        Interactive Sandbox
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 mb-4">
        Biblioteka Żywych Komponentów (Light Theme)
      </h1>
      <p class="text-slate-600 text-lg max-w-3xl leading-relaxed">
        Przetestuj interakcje, stany najechania (hover), pola formularza, karty usług w technologii Double-Bezel oraz architekturę przycisków.
      </p>
    </div>

    <!-- 1. BUTTONS & INTERACTIVE PILLS -->
    <section class="py-12 border-t border-slate-200/80">
      <div class="mb-8">
        <span class="text-xs font-mono font-semibold uppercase text-slate-400 tracking-wider">01. Interakcje</span>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Przyciski & "Button-in-Button" Trailing Icon</h2>
        <p class="text-slate-500 text-sm mt-1">Stworzone z myślą o urządzeniach dotykowych i myszach (haptic spring physics).</p>
      </div>

      <div class="p-8 rounded-2xl bg-white border border-slate-200 shadow-sm flex flex-wrap gap-6 items-center">
        <!-- Primary Action Button -->
        <button class="group inline-flex items-center gap-3 pl-6 pr-2.5 py-2.5 rounded-full bg-red-600 hover:bg-red-700 text-white font-semibold text-sm transition-all duration-300 shadow-lg shadow-red-600/20 active:scale-95">
          <span>Zapytaj o darmową wycenę</span>
          <span class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center group-hover:scale-110 group-hover:bg-white/30 transition-all duration-300">
            <ArrowUpRight class="w-4 h-4 text-white" />
          </span>
        </button>

        <!-- Secondary Corporate Button -->
        <button class="group inline-flex items-center gap-3 pl-6 pr-2.5 py-2.5 rounded-full bg-slate-900 hover:bg-slate-800 text-white font-semibold text-sm transition-all duration-300 active:scale-95">
          <span>Poznaj nasze usługi</span>
          <span class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-300">
            <ArrowUpRight class="w-4 h-4 text-white" />
          </span>
        </button>

        <!-- Outline / Subtle Pill -->
        <button class="group inline-flex items-center gap-3 pl-6 pr-2.5 py-2.5 rounded-full bg-white border border-slate-300 hover:border-slate-400 hover:bg-slate-50 text-slate-800 font-semibold text-sm transition-all duration-300 shadow-sm active:scale-95">
          <span>Pobierz certyfikat CNBOP</span>
          <span class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center group-hover:bg-slate-200 transition-colors">
            <ExternalLink class="w-4 h-4 text-slate-600" />
          </span>
        </button>

        <!-- Emergency / Hotline Call Button -->
        <a href="tel:+48781262626" class="inline-flex items-center gap-2.5 px-5 py-3 rounded-full bg-red-50 border border-red-200 text-red-700 font-bold text-sm hover:bg-red-100 transition-colors">
          <PhoneCall class="w-4 h-4 text-red-600 animate-pulse" />
          <span>+48 781 262 626 (Serwis 24/7)</span>
        </a>
      </div>
    </section>

    <!-- 2. SERVICE CARDS (BENTO & DOUBLE-BEZEL) -->
    <section class="py-12 border-t border-slate-200/80">
      <div class="mb-8">
        <span class="text-xs font-mono font-semibold uppercase text-slate-400 tracking-wider">02. Prezentacja Usług</span>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Karty Usług w Strukturze Double-Bezel</h2>
        <p class="text-slate-500 text-sm mt-1">Architektura asymetryczna dopasowana do oferty firmy Konektor.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Service Card 1: SSP -->
        <div class="double-bezel-outer group hover:-translate-y-1 transition-transform duration-300">
          <div class="double-bezel-inner p-8 flex flex-col justify-between h-full">
            <div>
              <div class="w-12 h-12 rounded-2xl bg-red-50 border border-red-200 text-red-600 flex items-center justify-center mb-6 shadow-sm">
                <Flame class="w-6 h-6" />
              </div>
              <div class="flex items-center gap-2 mb-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-red-600 font-mono">EN 54 / CNBOP</span>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-red-600 transition-colors">
                Systemy Sygnalizacji Pożaru
              </h3>
              <p class="text-slate-600 text-sm leading-relaxed mb-6">
                Wczesna detekcja dymu i ognia, centrale pożarowe, automatyczne uruchamianie procedur oddymiania i powiadamiania straży pożarnej.
              </p>
            </div>

            <div class="pt-6 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xs font-medium text-slate-400">Oferta & Serwis</span>
              <span class="w-8 h-8 rounded-full bg-slate-100 text-slate-700 flex items-center justify-center group-hover:bg-red-600 group-hover:text-white transition-all duration-300">
                <ArrowUpRight class="w-4 h-4" />
              </span>
            </div>
          </div>
        </div>

        <!-- Service Card 2: DSO -->
        <div class="double-bezel-outer group hover:-translate-y-1 transition-transform duration-300">
          <div class="double-bezel-inner p-8 flex flex-col justify-between h-full">
            <div>
              <div class="w-12 h-12 rounded-2xl bg-blue-50 border border-blue-200 text-blue-600 flex items-center justify-center mb-6 shadow-sm">
                <Volume2 class="w-6 h-6" />
              </div>
              <div class="flex items-center gap-2 mb-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-blue-600 font-mono">Dźwięk Ewakuacyjny</span>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-600 transition-colors">
                Dźwiękowe Systemy Ostrzegawcze
              </h3>
              <p class="text-slate-600 text-sm leading-relaxed mb-6">
                Czyste i zrozumiałe komunikaty głosowe sterujące ewakuacją ludzi. Precyzyjne strojenie akustyczne dla galerii i biurowców.
              </p>
            </div>

            <div class="pt-6 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xs font-medium text-slate-400">Oferta & Serwis</span>
              <span class="w-8 h-8 rounded-full bg-slate-100 text-slate-700 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-all duration-300">
                <ArrowUpRight class="w-4 h-4" />
              </span>
            </div>
          </div>
        </div>

        <!-- Service Card 3: CCTV & SKD -->
        <div class="double-bezel-outer group hover:-translate-y-1 transition-transform duration-300">
          <div class="double-bezel-inner p-8 flex flex-col justify-between h-full">
            <div>
              <div class="w-12 h-12 rounded-2xl bg-slate-100 border border-slate-200 text-slate-800 flex items-center justify-center mb-6 shadow-sm">
                <Camera class="w-6 h-6" />
              </div>
              <div class="flex items-center gap-2 mb-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-600 font-mono">Wideo & Kontrola</span>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-slate-700 transition-colors">
                Monitoring Wizyjny & SKD
              </h3>
              <p class="text-slate-600 text-sm leading-relaxed mb-6">
                Telewizja dozorowa 4K z analityką AI, czytniki biometryczne, bramki wejściowe i rejestracja czasu pracy personelu.
              </p>
            </div>

            <div class="pt-6 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xs font-medium text-slate-400">Oferta & Serwis</span>
              <span class="w-8 h-8 rounded-full bg-slate-100 text-slate-700 flex items-center justify-center group-hover:bg-slate-900 group-hover:text-white transition-all duration-300">
                <ArrowUpRight class="w-4 h-4" />
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. TRUST & STATS ARCHETYPE -->
    <section class="py-12 border-t border-slate-200/80">
      <div class="mb-8">
        <span class="text-xs font-mono font-semibold uppercase text-slate-400 tracking-wider">03. Dowód Społeczny</span>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Liczby i Referencje (Kolejność Optyczna)</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="p-8 rounded-2xl bg-white border border-slate-200 shadow-sm text-center">
          <div class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight font-mono mb-2">
            +20 <span class="text-red-600 text-2xl align-top font-sans">lat</span>
          </div>
          <p class="text-sm font-semibold text-slate-800">Doświadczenia na rynku</p>
          <p class="text-xs text-slate-500 mt-1">Ciągła obecność w branży od lat 2000</p>
        </div>

        <div class="p-8 rounded-2xl bg-white border border-slate-200 shadow-sm text-center">
          <div class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight font-mono mb-2">
            100<span class="text-red-600 text-3xl align-top font-sans">%</span>
          </div>
          <p class="text-sm font-semibold text-slate-800">Zgodności z normami</p>
          <p class="text-xs text-slate-500 mt-1">Certyfikowane instalacje i odbiory PSP</p>
        </div>

        <div class="p-8 rounded-2xl bg-white border border-slate-200 shadow-sm text-center">
          <div class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight font-mono mb-2">
            80<span class="text-red-600 text-3xl align-top font-sans">%</span>
          </div>
          <p class="text-sm font-semibold text-slate-800">Klientów powracających</p>
          <p class="text-xs text-slate-500 mt-1">Stałe umowy serwisowe i audytowe</p>
        </div>
      </div>
    </section>

    <!-- 4. FORMULARZ KONTAKTOWY (CLEAN ENTERPRISE LIGHT) -->
    <section class="py-12 border-t border-slate-200/80">
      <div class="mb-8">
        <span class="text-xs font-mono font-semibold uppercase text-slate-400 tracking-wider">04. Formularze & Inputy</span>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Stylistyka Formularza Kontaktowego</h2>
        <p class="text-slate-500 text-sm mt-1">Zaprojektowane z widocznym stanem skupienia (focus ring), czystymi etykietami i czytelnymi błędami.</p>
      </div>

      <div class="max-w-2xl bg-white rounded-3xl border border-slate-200 shadow-sm p-8 sm:p-10">
        <form class="space-y-5" onsubmit="event.preventDefault();">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                Imię i nazwisko <span class="text-red-600">*</span>
              </label>
              <input
                type="text"
                placeholder="np. Jan Kowalski"
                class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-600/30 focus:border-red-600 transition-all placeholder:text-slate-400"
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                Adres e-mail <span class="text-red-600">*</span>
              </label>
              <input
                type="email"
                placeholder="jan@firma.pl"
                class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-600/30 focus:border-red-600 transition-all placeholder:text-slate-400"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                Telefon kontaktowy
              </label>
              <input
                type="tel"
                placeholder="+48 ___ ___ ___"
                class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-600/30 focus:border-red-600 transition-all placeholder:text-slate-400"
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                Interesująca usługa
              </label>
              <div class="relative">
                <select class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-600/30 focus:border-red-600 transition-all appearance-none cursor-pointer">
                  <option>Systemy Sygnalizacji Pożaru (SSP)</option>
                  <option>Dźwiękowe Systemy Ostrzegawcze (DSO)</option>
                  <option>Systemy Sygnalizacji Włamania (SSWiN)</option>
                  <option>Systemy Kontroli Dostępu (SKD)</option>
                  <option>Monitoring Wizyjny (CCTV)</option>
                  <option>Przeglądy i legalizacja sprzętu PPOŻ</option>
                </select>
                <ChevronDown class="w-4 h-4 text-slate-400 absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none" />
              </div>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
              Opis obiektu lub zakres zapytania <span class="text-red-600">*</span>
            </label>
            <textarea
              rows="4"
              placeholder="Wpisz metraż obiektu, lokalizację lub specyfikę wymagań..."
              class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-600/30 focus:border-red-600 transition-all placeholder:text-slate-400"
            ></textarea>
          </div>

          <div class="pt-2">
            <button
              type="submit"
              class="w-full group inline-flex items-center justify-center gap-3 py-3.5 px-6 rounded-full bg-red-600 hover:bg-red-700 text-white font-semibold text-sm transition-all shadow-lg shadow-red-600/25 active:scale-[0.98]"
            >
              <span>Wyślij zapytanie ofertowe</span>
              <span class="w-7 h-7 rounded-full bg-white/20 flex items-center justify-center group-hover:translate-x-1 transition-transform">
                <ArrowUpRight class="w-4 h-4 text-white" />
              </span>
            </button>
            <p class="text-center text-xs text-slate-400 mt-3">
              Odpowiadamy w ciągu maksymalnie 24 godzin roboczych.
            </p>
          </div>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>
