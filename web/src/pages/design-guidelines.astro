---
import BaseLayout from '@/layouts/BaseLayout.astro'
import {
  Flame,
  Layers,
  ArrowUpRight,
  Sparkles,
  Sliders
} from 'lucide-astro'
---

<BaseLayout title="Design Guidelines & Visual System | Konektor" seo={{title: "Design Guidelines & Visual System | Konektor", noIndex: true}} hideGlobalNav>
  <!-- Agency Header -->
  <header class="border-b border-slate-200/80 bg-white/80 backdrop-blur-md sticky top-0 z-50 padding-global">
    <div class="container-large h-20 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-8 h-8 rounded-lg bg-red-600 flex items-center justify-center text-white text-sm tracking-tight shadow-sm group-hover:scale-105 transition-transform duration-300 font-medium">
            K
          </div>
          <span class="tracking-tight text-slate-900 text-lg font-medium">KONEKTOR</span>
        </a>
        <div class="h-4 w-px bg-slate-200 mx-2"></div>
        <span class="text-xs uppercase tracking-[0.2em] px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 border border-slate-200/60 font-normal">
          Design System · Urbanist (400 / 500)
        </span>
      </div>

      <nav class="hidden md:flex items-center gap-8 text-sm text-slate-600 font-normal">
        <a href="#philosophy" class="hover:text-slate-900 transition-colors">Filozofia</a>
        <a href="#color-matrix" class="hover:text-slate-900 transition-colors">Paleta Kolorów</a>
        <a href="#typography" class="hover:text-slate-900 transition-colors">Typografia</a>
        <a href="#spacings" class="hover:text-slate-900 transition-colors">Siatka & Odstępy</a>
        <a href="#hardware-ui" class="hover:text-slate-900 transition-colors">Architektura Hardware</a>
        <a href="/styleguide" class="text-red-600 font-medium flex items-center gap-1 hover:underline">
          Styleguide Lab <ArrowUpRight class="w-3.5 h-3.5" />
        </a>
      </nav>
    </div>
  </header>

  <main class="min-h-screen bg-[#F8F9FA] text-slate-900 pb-32 padding-global">
    <!-- Hero Section -->
    <section class="pt-20 pb-16 container-large">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-50 border border-red-200/60 text-red-700 text-xs uppercase tracking-[0.2em] mb-6 font-medium">
        <Sparkles class="w-3.5 h-3.5" /> Specyfikacja Wizualna & Design Guidelines
      </div>
      <h1 class="text-4xl sm:text-6xl tracking-tight text-slate-900 max-w-4xl leading-[1.1] mb-6">
        Zaprojektowane dla zaufania, precyzji i inżynierii bezpieczeństwa.
      </h1>
      <p class="text-lg sm:text-xl text-slate-600 max-w-3xl leading-relaxed font-normal">
        System wizualny Konektor oparty o krój pisma <strong class="font-medium text-slate-900">Urbanist</strong> (Regular 400 dla wszystkich partii tekstu i Medium 500 dla nagłówków). Doskonały balans pomiędzy czytelnością, nowoczesnością a technicznym profesjonalizmem.
      </p>
    </section>

    <!-- SECTION 1: Filozofia & DNA -->
    <section id="philosophy" class="py-12 container-large border-t border-slate-200/80">
      <div class="mb-8">
        <span class="text-xs uppercase text-slate-400 tracking-wider font-normal">01. Fundamenty</span>
        <h2 class="text-2xl sm:text-3xl tracking-tight text-slate-900 mt-1">Zasady Architektury Wizualnej</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-8 rounded-2xl bg-white border border-slate-200/80 shadow-[0_2px_12px_-4px_rgba(15,23,42,0.04)]">
          <div class="w-10 h-10 rounded-xl bg-red-50 text-red-600 flex items-center justify-center mb-6 border border-red-100">
            <Flame class="w-5 h-5" />
          </div>
          <h3 class="text-lg text-slate-900 mb-2">Signal & Authority</h3>
          <p class="text-slate-600 text-sm leading-relaxed font-normal">
            Czerwień sygnalizacyjna (<span class="text-red-600 font-medium">#D92D20</span>) zarezerwowana jest wyłącznie dla kluczowych akcentów, alarmów PPOŻ i głównych akcji (Primary CTA). Nie rozmywamy jej w tłumie.
          </p>
        </div>

        <div class="p-8 rounded-2xl bg-white border border-slate-200/80 shadow-[0_2px_12px_-4px_rgba(15,23,42,0.04)]">
          <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-800 flex items-center justify-center mb-6 border border-slate-200">
            <Layers class="w-5 h-5" />
          </div>
          <h3 class="text-lg text-slate-900 mb-2">Double-Bezel Hardware</h3>
          <p class="text-slate-600 text-sm leading-relaxed font-normal">
            Unikamy płaskich, tanich krawędzi. Kluczowe elementy konstrukcyjne bazują na fizycznej strukturze urządzeń alarmowych – zewnętrzna ramka z precyzyjnym wewnętrznym wcięciem.
          </p>
        </div>

        <div class="p-8 rounded-2xl bg-white border border-slate-200/80 shadow-[0_2px_12px_-4px_rgba(15,23,42,0.04)]">
          <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-6 border border-blue-100">
            <Sliders class="w-5 h-5" />
          </div>
          <h3 class="text-lg text-slate-900 mb-2">Spatial Breathing Room</h3>
          <p class="text-slate-600 text-sm leading-relaxed font-normal">
            Każda sekcja ma gigantyczny oddech (<code class="text-xs bg-slate-100 px-1.5 py-0.5 rounded font-normal">py-24</code> do <code class="text-xs bg-slate-100 px-1.5 py-0.5 rounded font-normal">py-36</code>). Przejrzystość redukuje stres decyzyjny menedżerów bezpieczeństwa.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 2: PALETA KOLORÓW -->
    <section id="color-matrix" class="py-16 container-large border-t border-slate-200/80">
      <div class="mb-10">
        <span class="text-xs uppercase text-slate-400 tracking-wider font-normal">02. Barwa i Kontrast</span>
        <h2 class="text-2xl sm:text-3xl tracking-tight text-slate-900 mt-1">System Barw: Light Enterprise</h2>
        <p class="text-slate-600 text-sm mt-1 font-normal">Czyste tło laboratoryjne z wysokim wskaźnikiem kontrastu (WCAG AAA).</p>
      </div>

      <!-- Color Groups -->
      <div class="space-y-12 font-normal">
        <!-- Brand Primary -->
        <div>
          <h3 class="text-sm uppercase tracking-wider text-slate-500 mb-4 font-medium">A. Główna Czerwień Bezpieczeństwa (Signal Crimson)</h3>
          <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-5 gap-4">
            <div class="p-4 rounded-xl bg-[#FEF3F2] border border-[#FECDCA]">
              <div class="h-16 rounded-lg bg-[#FEF3F2] border border-[#FECDCA] mb-3"></div>
              <p class="text-xs font-medium text-slate-900">Brand 50 (Subtle)</p>
              <p class="text-[11px] text-slate-500">#FEF3F2</p>
              <p class="text-[10px] text-slate-400 mt-1">Tła badge, hover chip</p>
            </div>
            <div class="p-4 rounded-xl bg-white border border-slate-200">
              <div class="h-16 rounded-lg bg-[#FECDCA] mb-3"></div>
              <p class="text-xs font-medium text-slate-900">Brand 200 (Border)</p>
              <p class="text-[11px] text-slate-500">#FECDCA</p>
              <p class="text-[10px] text-slate-400 mt-1">Obramowania akcentów</p>
            </div>
            <div class="p-4 rounded-xl bg-white border border-slate-200">
              <div class="h-16 rounded-lg bg-[#F04438] mb-3"></div>
              <p class="text-xs font-medium text-slate-900">Brand 500 (Base)</p>
              <p class="text-[11px] text-slate-500">#F04438</p>
              <p class="text-[10px] text-slate-400 mt-1">Wizualne punkty uwagi</p>
            </div>
            <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-sm ring-2 ring-red-600/20">
              <div class="h-16 rounded-lg bg-[#D92D20] mb-3 flex items-end p-2">
                <span class="text-[10px] font-medium text-white bg-black/30 px-1.5 py-0.5 rounded">PRIMARY</span>
              </div>
              <p class="text-xs font-medium text-slate-900">Brand 600 (Primary)</p>
              <p class="text-[11px] text-slate-500">#D92D20</p>
              <p class="text-[10px] text-slate-500 mt-1 font-medium">Główne przyciski & CTA</p>
            </div>
            <div class="p-4 rounded-xl bg-white border border-slate-200">
              <div class="h-16 rounded-lg bg-[#B42318] mb-3"></div>
              <p class="text-xs font-medium text-slate-900">Brand 700 (Hover/Deep)</p>
              <p class="text-[11px] text-slate-500">#B42318</p>
              <p class="text-[10px] text-slate-400 mt-1">Stany aktywne, click</p>
            </div>
          </div>
        </div>

        <!-- Slate Hierarchy -->
        <div>
          <h3 class="text-sm uppercase tracking-wider text-slate-500 mb-4 font-medium">B. Neutralna Paleta Architektoniczna (Surface & Slate)</h3>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
            <div class="p-4 rounded-xl bg-white border border-slate-200">
              <div class="h-14 rounded-lg bg-[#F8F9FA] border border-slate-300/80 mb-3"></div>
              <p class="text-xs font-medium text-slate-900">Canvas Base</p>
              <p class="text-[11px] text-slate-500">#F8F9FA</p>
              <p class="text-[10px] text-slate-400 mt-1">Główne tło strony</p>
            </div>
            <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-sm">
              <div class="h-14 rounded-lg bg-[#FFFFFF] border border-slate-200 mb-3"></div>
              <p class="text-xs font-medium text-slate-900">Pure White Card</p>
              <p class="text-[11px] text-slate-500">#FFFFFF</p>
              <p class="text-[10px] text-slate-400 mt-1">Karty, kontenery, modal</p>
            </div>
            <div class="p-4 rounded-xl bg-white border border-slate-200">
              <div class="h-14 rounded-lg bg-[#E2E8F0] mb-3"></div>
              <p class="text-xs font-medium text-slate-900">Border Light</p>
              <p class="text-[11px] text-slate-500">#E2E8F0</p>
              <p class="text-[10px] text-slate-400 mt-1">Separatory, linie podziału</p>
            </div>
            <div class="p-4 rounded-xl bg-white border border-slate-200">
              <div class="h-14 rounded-lg bg-[#64748B] mb-3"></div>
              <p class="text-xs font-medium text-slate-900">Text Muted</p>
              <p class="text-[11px] text-slate-500">#64748B</p>
              <p class="text-[10px] text-slate-400 mt-1">Podpisy, metadata</p>
            </div>
            <div class="p-4 rounded-xl bg-white border border-slate-200">
              <div class="h-14 rounded-lg bg-[#334155] mb-3"></div>
              <p class="text-xs font-medium text-slate-900">Text Secondary</p>
              <p class="text-[11px] text-slate-500">#334155</p>
              <p class="text-[10px] text-slate-400 mt-1">Akapity, opisy usług</p>
            </div>
            <div class="p-4 rounded-xl bg-white border border-slate-200">
              <div class="h-14 rounded-lg bg-[#0F172A] mb-3"></div>
              <p class="text-xs font-medium text-slate-900">Text Heading</p>
              <p class="text-[11px] text-slate-500">#0F172A</p>
              <p class="text-[10px] text-slate-400 mt-1">Tytuły H1-H3, liczby</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: TYPOGRAFIA URBANIST -->
    <section id="typography" class="py-16 container-large border-t border-slate-200/80">
      <div class="mb-10">
        <span class="text-xs uppercase text-slate-400 tracking-wider font-normal">03. Typografia & Hierarchia</span>
        <h2 class="text-2xl sm:text-3xl tracking-tight text-slate-900 mt-1">Krój Pisma: Urbanist (400 / 500)</h2>
        <p class="text-slate-600 text-sm mt-1 font-normal">
          Zgodnie z aktualizacją: <strong class="font-medium text-slate-900">Urbanist 500 (Medium)</strong> dla nagłówków oraz <strong class="font-normal text-slate-900">Urbanist 400 (Regular)</strong> dla wszystkich tekstów, inputów i linków.
        </p>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200/80 p-8 sm:p-12 shadow-sm divide-y divide-slate-100">
        <!-- Display 1 -->
        <div class="pb-8">
          <div class="flex items-center justify-between text-xs text-slate-400 mb-2 font-normal">
            <span>DISPLAY H1 (Urbanist 500 · Hero Heading)</span>
            <span>64px / 4rem · Leading 1.05 · Weight 500</span>
          </div>
          <div class="text-4xl sm:text-6xl tracking-tight text-slate-900 leading-[1.05]">
            Niezawodne systemy sygnalizacji pożaru.
          </div>
        </div>

        <!-- Heading 2 -->
        <div class="py-8">
          <div class="flex items-center justify-between text-xs text-slate-400 mb-2 font-normal">
            <span>HEADING H2 (Urbanist 500 · Section Heading)</span>
            <span>36px / 2.25rem · Leading 1.15 · Weight 500</span>
          </div>
          <div class="text-2xl sm:text-4xl tracking-tight text-slate-900">
            Kompleksowa ochrona życia i mienia w obiektach wielkokubaturowych.
          </div>
        </div>

        <!-- Heading 3 -->
        <div class="py-8">
          <div class="flex items-center justify-between text-xs text-slate-400 mb-2 font-normal">
            <span>HEADING H3 (Urbanist 500 · Card Heading)</span>
            <span>22px / 1.375rem · Leading 1.3 · Weight 500</span>
          </div>
          <div class="text-xl sm:text-2xl tracking-tight text-slate-900">
            Dźwiękowe Systemy Ostrzegawcze (DSO) zgodne z normą EN 54-16
          </div>
        </div>

        <!-- Body Regular -->
        <div class="py-8">
          <div class="flex items-center justify-between text-xs text-slate-400 mb-2 font-normal">
            <span>BODY LARGE (Urbanist 400 · Lead Paragraph)</span>
            <span>19px / 1.1875rem · Leading 1.6 · Weight 400 (Regular)</span>
          </div>
          <p class="text-lg sm:text-xl text-slate-600 leading-relaxed max-w-3xl font-normal">
            Od ponad dwóch dekad projektujemy i utrzymujemy certyfikowaną infrastrukturę teletechniczną. Zapewniamy precyzyjne dopasowanie scenariuszy pożarowych do specyfiki obiektu handlowego, biurowego i przemysłowego.
          </p>
        </div>

        <!-- Body Standard -->
        <div class="py-8">
          <div class="flex items-center justify-between text-xs text-slate-400 mb-2 font-normal">
            <span>BODY REGULAR (Urbanist 400 · Standard Text)</span>
            <span>16px / 1rem · Leading 1.6 · Weight 400 (Regular)</span>
          </div>
          <p class="text-base text-slate-600 leading-relaxed max-w-3xl font-normal">
            Wczesne wykrywanie zagrożenia pozwala na natychmiastową reakcję procedur ewakuacyjnych. Nasze centrale są zintegrowane ze stacjami monitorowania PSP oraz systemami klap dymowych.
          </p>
        </div>

        <!-- Eyebrow Tag -->
        <div class="pt-8">
          <div class="flex items-center justify-between text-xs text-slate-400 mb-3 font-normal">
            <span>EYEBROW BADGE (Urbanist 500 · Metadata)</span>
            <span>11px · Weight 500 · Tracking +0.2em (Uppercase)</span>
          </div>
          <div class="flex flex-wrap gap-3 font-medium">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-[11px] uppercase tracking-[0.2em] bg-red-50 text-red-700 border border-red-200">
              Systemy Sygnalizacji Pożaru
            </span>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-[11px] uppercase tracking-[0.2em] bg-slate-100 text-slate-700 border border-slate-200">
              Norma PN-EN 54
            </span>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-[11px] uppercase tracking-[0.2em] bg-blue-50 text-blue-700 border border-blue-200">
              Monitoring Wizyjny 4K
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: ARCHITEKTURA HARDWARE & DOUBLE BEZEL -->
    <section id="hardware-ui" class="py-16 container-large border-t border-slate-200/80">
      <div class="mb-10">
        <span class="text-xs uppercase text-slate-400 tracking-wider font-normal">04. Komponenty Fizyczne</span>
        <h2 class="text-2xl sm:text-3xl tracking-tight text-slate-900 mt-1">Architektura "Double-Bezel" (Doppelrand)</h2>
        <p class="text-slate-600 text-sm mt-1 font-normal">Karty zaprojektowane jak precyzyjny sprzęt inżynieryjny z podwójnym rantem.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        <!-- Live Demonstration Card -->
        <div class="double-bezel-outer">
          <div class="double-bezel-inner p-8">
            <div class="flex items-center justify-between mb-6 font-normal">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 ring-4 ring-emerald-100 animate-pulse"></span>
                <span class="text-xs text-slate-600 uppercase tracking-wider">Stan: Aktywny</span>
              </div>
              <span class="text-xs text-slate-400 bg-slate-100 px-2 py-0.5 rounded">ID: SSP-740</span>
            </div>

            <h3 class="text-xl sm:text-2xl tracking-tight text-slate-900 mb-2">Centrala Pożarowa i Czujniki Optyczne</h3>
            <p class="text-slate-600 text-base leading-relaxed mb-6 font-normal">
              Przykład wyrenderowania karty usługi z wykorzystaniem zasady podwójnej ramki (Double-Bezel). Cień wewnętrzny i zewnętrzny obrys nadają głębię niedostępną dla standardowych szablonów.
            </p>

            <div class="pt-6 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xs text-slate-500 font-normal">Certyfikacja CNBOP</span>
              
              <!-- Button-in-Button Pattern -->
              <a href="#demo" class="group inline-flex items-center gap-3 pl-5 pr-2 py-2 rounded-full bg-slate-900 text-white text-xs hover:bg-red-600 transition-colors duration-300 font-medium">
                <span>Sprawdź parametry</span>
                <span class="w-7 h-7 rounded-full bg-white/10 flex items-center justify-center group-hover:scale-110 group-hover:bg-white/20 transition-all duration-300">
                  <ArrowUpRight class="w-3.5 h-3.5 text-white" />
                </span>
              </a>
            </div>
          </div>
        </div>

        <!-- Explanation Specs -->
        <div class="space-y-4 font-normal">
          <div class="p-6 rounded-2xl bg-white border border-slate-200/80">
            <h4 class="text-sm text-slate-900 mb-1 font-medium">1. Outer Shell (Warstwa Zewnętrzna)</h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              bg: rgba(15, 23, 42, 0.02) · border: 1px solid rgba(15, 23, 42, 0.05) · p-1.5 · rounded-3xl
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-white border border-slate-200/80">
            <h4 class="text-sm text-slate-900 mb-1 font-medium">2. Inner Core (Rdzeń z Akcentem Światła)</h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              bg: #FFFFFF · shadow: [inset 0 1px 0 #FFF, 0 2px 8px rgba(0,0,0,0.03)] · rounded-[calc(1.5rem-0.375rem)]
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-white border border-slate-200/80">
            <h4 class="text-sm text-slate-900 mb-1 font-medium">3. Button-in-Button CTA</h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Zamiast surowej strzałki obok tekstu, ikona posiada własne, zagnieżdżone koło reakcyjne (<code class="text-[11px] bg-slate-100 px-1 py-0.5 rounded font-normal">w-7 h-7 rounded-full bg-white/10</code>), które animuje się niezależnie podczas najechania kursorem.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Bottom CTA Bar -->
    <section class="py-12 container-large">
      <div class="p-8 sm:p-12 rounded-3xl bg-slate-900 text-white flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl shadow-slate-950/10">
        <div>
          <h3 class="text-2xl sm:text-3xl tracking-tight mb-1 font-medium">Przetestuj interaktywne komponenty na żywo</h3>
          <p class="text-slate-400 text-sm font-normal">Otwórz laboratorium komponentów, przycisków, formularzy i kart usług z fontem Urbanist (400 / 500).</p>
        </div>
        <a href="/styleguide" class="inline-flex items-center gap-3 px-6 py-3.5 rounded-full bg-red-600 hover:bg-red-500 text-white text-sm transition-all shadow-lg shadow-red-600/20 active:scale-95 font-medium">
          <span>Otwórz Styleguide Lab</span>
          <ArrowUpRight class="w-4 h-4" />
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
